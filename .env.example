# Copy to .env and fill in real values. Never commit .env.
# Generate any secret below with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# dev | test | production. Anything but production enables CORS for the Vite dev
# server on :5173; production is same-origin and needs none.
ENV=dev

# --- OpenAI -----------------------------------------------------------------
# https://platform.openai.com/api-keys — also set a $50/month org spend cap there,
# the one guard a bug in this repo cannot bypass.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the API base (proxies, Azure-compatible gateways)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Dated snapshots, never the floating alias — a silent model swap would move
# extraction quality with no diff to point at.
LLM_MODEL_EXTRACT=gpt-5.5-2026-04-23
LLM_MODEL_REPORT=gpt-5.5-2026-04-23

# --- Database ---------------------------------------------------------------
# Railway hands out postgresql://; the app rewrites it to postgresql+asyncpg://.
DATABASE_URL=postgresql://penny:penny@localhost:5432/penny
# DB tests skip unless this is set (docker-compose.yml brings up a local Postgres).
PENNY_TEST_DATABASE_URL=postgresql://penny:penny@localhost:5432/penny_test

# --- Auth -------------------------------------------------------------------
# Signs the HttpOnly session cookie carrying household_id. Rotating it logs everyone out.
SESSION_SECRET=change-me-64-hex-chars
SESSION_MAX_AGE_DAYS=30

# --- GOWA (WhatsApp sidecar) ------------------------------------------------
# The pinned go-whatsapp-web-multidevice service; internal Railway URL in production.
GOWA_URL=http://localhost:3000
# APP_BASIC_AUTH on the GOWA side, as "user:pass".
GOWA_BASIC_AUTH=penny:change-me
# HMAC-SHA256 key for X-Hub-Signature-256 on inbound webhooks. GOWA's default is
# literally "secret" — change it on BOTH sides or the webhook is unauthenticated.
WHATSAPP_WEBHOOK_SECRET=change-me-64-hex-chars

# --- Scheduled work ---------------------------------------------------------
# Shared secret the Railway cron service sends when POSTing /api/internal/tick.
INTERNAL_TICK_SECRET=change-me-64-hex-chars

# --- Spend guards -----------------------------------------------------------
# Hard ceiling for one import run; aborts mid-flight leaving extracted_at NULL so
# the hourly tick resumes it.
IMPORT_MAX_SPEND_USD=25
LLM_MONTHLY_BUDGET_USD_PER_HOUSEHOLD=15

# --- Group onboarding -------------------------------------------------------
# Adding Penny to a WhatsApp group provisions that group's household and posts the
# credentials INTO the group. Only members of the group can read them, which is
# what makes possession of the group the proof of ownership.
#
# THESE TWO ARE THE LEVERS IF THE WHATSAPP NUMBER LEAKS, in this order:
#   ONBOARDING_ENABLED=false     stops it dead — an unknown group goes back to a
#                                silent 200 with nothing written. Existing
#                                households are unaffected.
#   ONBOARDING_MAX_HOUSEHOLDS    the ceiling while it stays on. The exposure is the
#                                OpenAI bill, not data: every household runs
#                                extraction, so unbounded signups starve the real
#                                families of budget. Lower it, don't remove it.
ONBOARDING_ENABLED=true
ONBOARDING_MAX_HOUSEHOLDS=25
# Goes into the welcome message, so a wrong value is a dead link in the first thing
# a family ever sees. No trailing slash needed.
APP_PUBLIC_URL=https://pennyai.chat

# --- Misc -------------------------------------------------------------------
DEFAULT_TIMEZONE=Europe/London
# Serve frontend/dist from the API process (true on Railway, false when running Vite).
SERVE_FRONTEND=true
