# Copy to .env and fill in real values. Never commit .env.
#
# THIS FILE IS THE COMPLETE LIST. If a setting is not below, it has a working
# default in backend/app/config.py and you should NOT set it — not here, and not
# in Railway. Setting one anyway forks the running configuration away from the
# repo, and then reading config.py no longer tells you what production does.
# Every field there is declared through env_specific() / secret() / infra() /
# code_default(), and backend/tests/test_config_surface.py fails if a new field
# skips that decision or if a code_default() variable reappears in this file.
#
# EVERY PLACEHOLDER IN THIS FILE IS REJECTED AT BOOT WHEN ENV=production.
# This file is public, so any literal in it is a published string — a deploy that
# inherited one would be signing session cookies with a value anyone can read.
# backend/app/startup_checks.py lists them all and refuses to start on them, on a
# length below 32 characters, and on GOWA's own defaults. In dev it only warns, so
# a fresh copy of this file still runs. Adding a secret here means adding it to
# PUBLISHED_PLACEHOLDERS there; tests/test_startup_checks.py fails if you forget.


# ==============================================================================
# 1. ENVIRONMENT-SPECIFIC — the only two values a human has to bring.
#    Everything else below is either generated by a script or a fact about where
#    the app is deployed. These two are not: nothing can invent them for you.
# ==============================================================================

# https://platform.openai.com/api-keys — also set a $50/month org spend cap there,
# the one guard a bug in this repo cannot bypass. Leaving it unset is legal: the
# app boots and serves the feed with extraction and transcription disabled.
OPENAI_API_KEY=sk-REPLACE_ME

# The domain this deployment answers on. It goes into the WhatsApp welcome
# message, so a wrong value is a dead link in the first thing a family ever sees.
# No trailing slash. Defaults to https://pennyai.chat (production); override it
# for local dev, a staging copy, or a fork.
APP_PUBLIC_URL=http://localhost:8000


# ==============================================================================
# 2. SECRETS — per-deployment, but GENERATED, never copied from somewhere else.
#    Mint each one with:
#        python -c "import secrets; print(secrets.token_hex(32))"
#    A teammate replicating this deployment does not need to learn any existing
#    value; they generate their own. Minimum 32 characters, enforced at boot.
# ==============================================================================

# Signs the HttpOnly session cookie carrying household_id. Rotating it logs
# everyone out. Required — the app refuses to boot in production without it.
SESSION_SECRET=REPLACE_ME

# APP_BASIC_AUTH on the GOWA side, as "user:pass". Exactly one colon: GOWA splits
# on it and exits unless it gets two parts, so a colon in the password kills the
# sidecar. No commas either — Railway's -v flags split on them.
GOWA_BASIC_AUTH=penny:REPLACE_ME

# HMAC-SHA256 key for X-Hub-Signature-256 on inbound webhooks. GOWA's default is
# literally "secret" — set the SAME value on both sides or the webhook is
# unauthenticated and anyone can inject messages into a household's timeline.
WHATSAPP_WEBHOOK_SECRET=REPLACE_ME

# Shared secret the cron service sends when POSTing /api/internal/tick.
INTERNAL_TICK_SECRET=REPLACE_ME


# ==============================================================================
# 3. INFRASTRUCTURE — facts about where this process is running. The provisioning
#    script sets these verbatim in Railway (DATABASE_URL as a reference to the
#    Postgres addon, GOWA_URL as the sidecar's internal DNS name). Locally they
#    describe docker-compose. Not preferences; do not tune them.
# ==============================================================================

# dev | test | production. Anything but production enables CORS for the Vite dev
# server on :5173 and downgrades the startup secret checks from fatal to warning;
# production is same-origin and fails closed.
ENV=dev

# Railway hands out postgresql://; the app rewrites it to postgresql+asyncpg://.
# This is the docker-compose database with its published penny/penny credentials —
# real for dev, and refused in production for exactly that reason.
DATABASE_URL=postgresql://penny:penny@localhost:5432/penny

# DB tests skip unless this is set (docker-compose.yml brings up a local Postgres).
# Never set in production; nothing outside the test suite reads it.
PENNY_TEST_DATABASE_URL=postgresql://penny:penny@localhost:5432/penny_test

# The pinned go-whatsapp-web-multidevice sidecar. In production this is the
# internal Railway address, http://gowa.railway.internal:3000. Unset disables
# outbound WhatsApp, which is a supported way to run the API alone.
GOWA_URL=http://localhost:3000

# Only for a proxy or an Azure-compatible gateway. Unset means api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1


# ==============================================================================
# 4. EVERYTHING ELSE HAS A DEFAULT IN config.py — DO NOT SET IT.
#
#    Model pins, spend guards, extraction cadence, onboarding limits and kill
#    switches, transcription limits, timezone, frontend serving, session
#    lifetime. Production runs on the values in backend/app/config.py, so
#    changing one is a commit and a two-minute deploy, and the change is visible
#    in the diff forever. That is the point: a dashboard toggle changes
#    production behaviour with no diff anywhere.
#
#    The one exception worth knowing about while developing:
#      # SERVE_FRONTEND=false   # if you run Vite on :5173 and want the API to
#                               # stop answering for the frontend routes
# ==============================================================================
