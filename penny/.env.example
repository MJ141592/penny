# Copy to .env and fill in. Both the engine and the web apps read this file.
#
# Generate the two secrets with:
#   openssl rand -hex 16

# Where the GOWA engine listens
GOWA_PORT=3000
GOWA_URL=http://localhost:3000

# Basic auth on the GOWA API. The browser never sees these — the Next.js
# server-side proxy attaches them.
GOWA_USER=penny
GOWA_PASS=replace-me

# Where the web UI listens, and where GOWA posts inbound events
WEB_PORT=3001
WEBHOOK_URL=http://localhost:3001/api/webhook
WEBHOOK_SECRET=replace-me
